{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "VITE_BASE44_APP_ID",
      "description": "Base44 App ID from the Base44 Builder",
      "requiredAtBoot": false
    },
    {
      "name": "VITE_BASE44_APP_BASE_URL",
      "description": "Base44 app backend URL (e.g. https://my-app.base44.app)",
      "requiredAtBoot": false
    }
  ]
}
