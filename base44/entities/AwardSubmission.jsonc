{
  "name": "AwardSubmission",
  "type": "object",
  "description": "Inscri\u00e7\u00e3o de um case em uma premia\u00e7\u00e3o, feita por um candidato (entrant). O candidato tem EventMembership role=entrant (sem acesso ao evento at\u00e9 ser promovido).",
  "properties": {
    "award_id": {
      "type": "string",
      "description": "ID da AwardConfig"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento (denormalizado)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person que submeteu (candidato)"
    },
    "submitter_name": {
      "type": "string"
    },
    "submitter_email": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do case"
    },
    "summary": {
      "type": "string",
      "description": "Resumo do case"
    },
    "custom_answers": {
      "type": "string",
      "description": "JSON com respostas dos campos do form_config"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "finalist",
        "winner",
        "rejected"
      ],
      "default": "pending"
    },
    "assigned_reviewer_ids": {
      "type": "string",
      "description": "JSON array de user_ids dos avaliadores designados"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "award_id",
    "event_id",
    "person_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}