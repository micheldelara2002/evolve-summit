{
  "name": "AwardSubmission",
  "type": "object",
  "description": "Inscri\u00e7\u00e3o de um case em uma premia\u00e7\u00e3o, feita por um candidato (entrant). ESCRITA (2026-11-06): SDK direto travado para admin \u2014 a inscri\u00e7\u00e3o nasce por manageAward.submitCase (valida janela, formul\u00e1rio e identidade) e o status \u00e9 decidido pela gest\u00e3o em manageAward (promoteWinner/setStatus). O candidato n\u00e3o altera o pr\u00f3prio status. LEITURA: pr\u00f3prio autor (e-mail do snapshot ou created_by) e admin; a banca avalia via manageAward.",
  "properties": {
    "award_id": {
      "type": "string",
      "description": "ID da AwardConfig"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento (denormalizado)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person que submeteu (candidato)"
    },
    "submitter_name": {
      "type": "string"
    },
    "submitter_email": {
      "type": "string",
      "description": "E-mail do candidato (snapshot, normalizado)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do case"
    },
    "summary": {
      "type": "string",
      "description": "Resumo do case"
    },
    "custom_answers": {
      "type": "string",
      "description": "JSON com respostas dos campos do form_config"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "finalist",
        "winner",
        "rejected"
      ],
      "default": "pending",
      "description": "Andamento da inscri\u00e7\u00e3o \u2014 alterado apenas pela gest\u00e3o do evento (manageAward)"
    },
    "assigned_reviewer_ids": {
      "type": "string",
      "description": "JSON array de user_ids dos avaliadores designados"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "award_id",
    "event_id",
    "person_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}