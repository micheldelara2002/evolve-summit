{
  "name": "AwardEvaluation",
  "type": "object",
  "description": "Avalia\u00e7\u00e3o de um case (AwardSubmission) feita por um avaliador da banca. ESCRITA (2026-11-06): SDK direto travado para admin \u2014 nota e total s\u00e3o calculados e validados no servidor (manageAward.saveEvaluation): s\u00f3 crit\u00e9rios existentes, valor num\u00e9rico, n\u00e3o negativo e dentro do m\u00e1ximo. LEITURA: o pr\u00f3prio avaliador e admin; a gest\u00e3o consulta o ranking por manageAward.listResults.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "award_id": {
      "type": "string",
      "description": "ID da AwardConfig"
    },
    "submission_id": {
      "type": "string",
      "description": "ID da AwardSubmission avaliada"
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "ID do User avaliador"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome do avaliador (snapshot)"
    },
    "scores": {
      "type": "string",
      "description": "JSON: {criteria_id: score} \u2014 normalizado pelo servidor"
    },
    "total_score": {
      "type": "number",
      "default": 0,
      "description": "Soma ponderada calculada no servidor"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "submitted"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "award_id",
    "submission_id",
    "reviewer_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}