{
  "name": "AwardEvaluation",
  "type": "object",
  "description": "Avalia\u00e7\u00e3o de um indicado feita por um avaliador (reviewer). Uma por avaliador por indica\u00e7\u00e3o.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string",
      "description": "ID da AwardCategory"
    },
    "nomination_id": {
      "type": "string",
      "description": "ID da AwardNomination"
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "ID do User avaliador"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome do avaliador (snapshot)"
    },
    "scores": {
      "type": "string",
      "description": "JSON: {criteria_id: score}"
    },
    "total_score": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "submitted"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "category_id",
    "nomination_id",
    "reviewer_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}