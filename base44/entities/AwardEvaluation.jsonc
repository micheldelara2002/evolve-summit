{
  "name": "AwardEvaluation",
  "type": "object",
  "description": "Avaliação de um case (AwardSubmission) feita por um avaliador designado pelo gerente. Uma por avaliador por inscrição.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "award_id": {
      "type": "string",
      "description": "ID da AwardConfig"
    },
    "submission_id": {
      "type": "string",
      "description": "ID da AwardSubmission avaliada"
    },
    "reviewer_user_id": {
      "type": "string",
      "description": "ID do User avaliador"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome do avaliador (snapshot)"
    },
    "scores": {
      "type": "string",
      "description": "JSON: {criteria_id: score}"
    },
    "total_score": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "submitted"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "award_id",
    "submission_id",
    "reviewer_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
