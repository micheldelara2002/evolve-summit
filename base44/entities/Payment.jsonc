{
  "name": "Payment",
  "type": "object",
  "description": "Registro de transa\u00e7\u00e3o de pagamento (Stripe). status: pending, succeeded, failed, expired, refunded, partially_refunded. fulfillment marcado idempotentemente. Nunca escrito diretamente pelo cliente \u2014 apenas via backend functions (service role).",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID do Order"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "buyer_user_id": {
      "type": "string",
      "description": "ID do User comprador"
    },
    "intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID"
    },
    "charge_id": {
      "type": "string",
      "description": "Stripe Charge ID (ap\u00f3s sucesso)"
    },
    "amount": {
      "type": "number",
      "description": "Valor cobrado em BRL"
    },
    "amount_cents": {
      "type": "number",
      "description": "Valor em centavos (Stripe)"
    },
    "currency": {
      "type": "string",
      "default": "BRL"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "expired",
        "refunded",
        "partially_refunded"
      ],
      "default": "pending"
    },
    "provider": {
      "type": "string",
      "default": "stripe"
    },
    "payment_method": {
      "type": "string",
      "description": "pix ou card (snapshot)"
    },
    "client_secret": {
      "type": "string",
      "description": "Client secret do PaymentIntent (devolvido ao frontend)"
    },
    "refunded_amount": {
      "type": "number",
      "default": 0,
      "description": "Total estornado em BRL"
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "pending",
        "fulfilled",
        "pending_retry",
        "failed"
      ],
      "default": "pending",
      "description": "Estado do fulfillment de participantes/ingressos"
    },
    "error_reason": {
      "type": "string",
      "description": "Motivo de falha (se houver)"
    },
    "succeeded_at": {
      "type": "string",
      "format": "date-time"
    },
    "destination_account_id": {
      "type": "string",
      "description": "P0.4 \u2014 ID da conta Stripe Connect (acct_...) do organizador que recebeu esta venda via destination charge. Vazio = venda recebida na conta da plataforma."
    },
    "application_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "P0.4 \u2014 Comiss\u00e3o da plataforma retida nesta venda (BRL), via application_fee do destination charge."
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "event_id",
    "buyer_user_id",
    "intent_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}