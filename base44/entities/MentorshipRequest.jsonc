{
  "name": "MentorshipRequest",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o de origem"
    },
    "participant_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "mentor_participant_id": {
      "type": "string",
      "description": "Participant ID do palestrante/mentor"
    },
    "topic": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "completed",
        "cancelled"
      ],
      "default": "requested"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "participant_id"
  ]
}