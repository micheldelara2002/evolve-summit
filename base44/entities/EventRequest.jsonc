{
  "name": "EventRequest",
  "type": "object",
  "description": "Solicita\u00e7\u00e3o de cria\u00e7\u00e3o de evento feita por um manager. Cada evento \u00e9 uma fonte de receita da plataforma, ent\u00e3o a solicita\u00e7\u00e3o N\u00c3O cria evento: s\u00f3 o admin aprova (manageEventRequest) e a aprova\u00e7\u00e3o \u00e9 o \u00fanico caminho que cria o Event, o v\u00ednculo de gerente e as trilhas/salas iniciais. Rejeitada, a solicita\u00e7\u00e3o nunca vira evento gerenci\u00e1vel.",
  "properties": {
    "requested_by_user_id": {
      "type": "string",
      "description": "ID do User que solicitou"
    },
    "requested_by_name": {
      "type": "string",
      "description": "Nome de quem solicitou (snapshot)"
    },
    "requested_by_email": {
      "type": "string",
      "description": "E-mail de quem solicitou, normalizado (chave do v\u00ednculo de gerente na aprova\u00e7\u00e3o)"
    },
    "name": {
      "type": "string",
      "description": "Nome proposto do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o proposta"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio proposto"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "T\u00e9rmino proposto"
    },
    "location": {
      "type": "string",
      "description": "Local proposto"
    },
    "expected_participants": {
      "type": "number",
      "description": "P\u00fablico esperado (usado na an\u00e1lise comercial do admin)"
    },
    "manager_email": {
      "type": "string",
      "description": "E-mail de quem vai gerir o evento se for diferente de quem solicitou (opcional, normalizado)"
    },
    "notes": {
      "type": "string",
      "description": "Justificativa/observa\u00e7\u00f5es do solicitante"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "canceled"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "description": "Estado da solicita\u00e7\u00e3o. Somente 'approved' produziu um Event."
    },
    "review_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do admin na decis\u00e3o"
    },
    "reviewed_by_user_id": {
      "type": "string",
      "description": "ID do admin que decidiu"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Nome do admin que decidiu"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a decis\u00e3o foi tomada"
    },
    "created_event_id": {
      "type": "string",
      "description": "ID do Event criado na aprova\u00e7\u00e3o (idempot\u00eancia: uma solicita\u00e7\u00e3o gera no m\u00e1ximo um evento)"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "requested_by_user_id",
    "name",
    "start_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requested_by_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.requested_by_user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}