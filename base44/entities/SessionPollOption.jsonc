{
  "name": "SessionPollOption",
  "type": "object",
  "description": "Op\u00e7\u00f5es de resposta de uma enquete.",
  "properties": {
    "poll_id": {
      "type": "string",
      "description": "ID da enquete"
    },
    "option_text": {
      "type": "string",
      "description": "Texto da op\u00e7\u00e3o"
    },
    "position": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "poll_id",
    "option_text"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}