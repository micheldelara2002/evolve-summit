{
  "name": "AwardConfig",
  "type": "object",
  "description": "Configura\u00e7\u00e3o de uma premia\u00e7\u00e3o (edi\u00e7\u00e3o do pr\u00eamio) de um evento. Define o formul\u00e1rio de inscri\u00e7\u00e3o do case (form_config), os crit\u00e9rios de avalia\u00e7\u00e3o do comit\u00ea (criteria_config) e a banca avaliadora designada (assigned_reviewer_ids), al\u00e9m do per\u00edodo de inscri\u00e7\u00e3o.",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento (chave de isolamento)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da premia\u00e7\u00e3o (ex: Pr\u00eamio Inova\u00e7\u00e3o 2026)"
    },
    "description": {
      "type": "string",
      "description": "Instru\u00e7\u00f5es exibidas ao candidato"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio do per\u00edodo de inscri\u00e7\u00e3o"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do per\u00edodo de inscri\u00e7\u00e3o"
    },
    "form_config": {
      "type": "string",
      "description": "JSON array de campos do formul\u00e1rio de inscri\u00e7\u00e3o: [{label, type, required, options}]"
    },
    "criteria_config": {
      "type": "string",
      "description": "JSON array de crit\u00e9rios de avalia\u00e7\u00e3o: [{id, label, weight, max_score}]"
    },
    "assigned_reviewer_ids": {
      "type": "string",
      "description": "JSON array de user_ids da banca avaliadora designada para esta premia\u00e7\u00e3o",
      "default": "[]"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "title",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}