{
  "name": "Speaker",
  "type": "object",
  "description": "DEPRECATED: Entidade legada. Palestrantes s\u00e3o gerenciados via Participant (role_in_event='speaker'). N\u00e3o criar/editar novos registros aqui.",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "bio": {
      "type": "string",
      "description": "Biografia"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto"
    },
    "company": {
      "type": "string",
      "description": "Empresa"
    },
    "title": {
      "type": "string",
      "description": "Cargo/t\u00edtulo"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "full_name",
    "email"
  ]
}