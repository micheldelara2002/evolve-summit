{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "Papel global do usu\u00e1rio no sistema"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (normalizado)"
    },
    "bio": {
      "type": "string",
      "description": "Sobre mim"
    }
  }
}