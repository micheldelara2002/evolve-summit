{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member",
        "partner_manager"
      ],
      "default": "member",
      "description": "Papel global do usu\u00e1rio no sistema"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "person_id": {
      "type": "string",
      "description": "ID da pessoa vinculada (Person entity)"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "dark",
      "description": "Prefer\u00eancia de tema visual do usu\u00e1rio"
    }
  }
}