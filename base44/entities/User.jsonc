{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "Papel global do usu\u00e1rio no sistema. Apenas admin (acesso total) e member (demais). Fun\u00e7\u00f5es de neg\u00f3cio (gestor de parceiro, palestrante, curador, avaliador, etc.) s\u00e3o definidas em PartnerRepresentative e EventMembership \u2014 n\u00e3o aqui."
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "person_id": {
      "type": "string",
      "description": "ID da pessoa vinculada (Person entity)"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "dark",
      "description": "Prefer\u00eancia de tema visual do usu\u00e1rio"
    }
  }
}