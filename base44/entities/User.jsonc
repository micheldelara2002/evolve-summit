{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Papel global do usu\u00e1rio no sistema (padr\u00e3o nativo Base44). Apenas admin (acesso total) e user (demais). O label exibido ao usu\u00e1rio para 'user' \u00e9 'Membro'. Fun\u00e7\u00f5es de neg\u00f3cio (gestor de parceiro, palestrante, curador, avaliador, etc.) s\u00e3o definidas em PartnerRepresentative e EventMembership \u2014 n\u00e3o aqui."
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "person_id": {
      "type": "string",
      "description": "ID da pessoa vinculada (Person entity)"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "dark",
      "description": "Prefer\u00eancia de tema visual do usu\u00e1rio"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ],
      "default": "active",
      "description": "Estado da conta. 'deleted' = conta exclu\u00edda pelo pr\u00f3prio usu\u00e1rio (PII anonimizada, acesso bloqueado). O registro de autentica\u00e7\u00e3o permanece pois a plataforma n\u00e3o exp\u00f5e hard-delete de User via SDK."
    },
    "created_day": {
      "type": "string",
      "description": "P0.3 \u2014 Chave do dia (YYYY-MM-DD) derivada do created_date. Usada para corre\u00e7\u00e3o de borda no Business Dashboard (equality query). Populado no signup via workflow (maintainBusinessCounter incUsers); backfill via reconcileGlobalMetrics."
    }
  }
}