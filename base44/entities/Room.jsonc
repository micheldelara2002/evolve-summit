{
  "name": "Room",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "name": {
      "type": "string",
      "description": "Nome da sala"
    },
    "capacity": {
      "type": "number",
      "description": "Capacidade"
    },
    "floor": {
      "type": "string",
      "description": "Andar"
    },
    "block": {
      "type": "string",
      "description": "Bloco"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "name"
  ]
}