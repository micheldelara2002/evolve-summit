{
  "name": "CheckoutLock",
  "type": "object",
  "description": "FIN-001 r2 \u2014 Detalhes do lock de exclusividade de checkout por (comprador, evento), permitindo locks SIMULT\u00c2NEOS e INDEPENDENTES em eventos distintos (o lock \u00fanico escalar na Person permitia reabrir a corrida alternando eventos A\u2192B\u2192A). O PORT\u00c3O at\u00f4mico \u00e9 o array Person.checkout_lock_events (CAS $ne+$push \u2014 exatamente um vencedor por evento em corrida; primitiva da mesma fam\u00edlia do registro de cupons DAT-001, validada em produ\u00e7\u00e3o 2026-09-28). Este registro guarda os detalhes do lock vivo (pedido pendente e TTL) e \u00e9 escrito APENAS pelo vencedor do port\u00e3o \u2014 sem corrida de escrita. Libera\u00e7\u00e3o idempotente e ESCOPADA por evento em falha do checkout, cancelamento/expira\u00e7\u00e3o (expirador) e pagamento confirmado (fulfillment).",
  "properties": {
    "person_id": {
      "type": "string",
      "description": "ID da Person do comprador"
    },
    "user_id": {
      "type": "string",
      "description": "ID do User comprador (rastreio/auditoria)"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento travado (chave de escopo \u2014 nunca toca locks de outros eventos)"
    },
    "order_id": {
      "type": "string",
      "description": "ID do pedido pendente associado ao lock (vazio at\u00e9 o pedido ser criado/reusado via attachCheckoutLock)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Validade do lock (TTL de 15 min = janela de reserva do checkout). Vencido por tempo, o pr\u00f3ximo claim do mesmo evento readquire \u2014 sem locks \u00f3rf\u00e3os."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "released"
      ],
      "default": "active",
      "description": "active = lock vivo; released = liberado (registro mantido por hist\u00f3rico, nunca reutilizado)"
    },
    "released_reason": {
      "type": "string",
      "description": "Motivo da libera\u00e7\u00e3o: failure (falha do checkout), cancelled (expirador), paid (fulfillment confirmado), expired (TTL vencido), stale_orphan (recupera\u00e7\u00e3o), e2e-cleanup"
    }
  },
  "required": [
    "person_id",
    "event_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}