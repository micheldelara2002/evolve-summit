{
  "name": "PartnerRepresentative",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "ID do partner (empresa)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person vinculada (obrigat\u00f3rio)"
    },
    "user_id": {
      "type": "string",
      "description": "ID do User vinculado (opcional, se tiver conta de acesso)"
    },
    "role_in_partner": {
      "type": "string",
      "description": "Papel na empresa: partner_manager, representative"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 o representante principal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o v\u00ednculo est\u00e1 ativo"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "partner_id",
    "person_id",
    "role_in_partner"
  ]
}