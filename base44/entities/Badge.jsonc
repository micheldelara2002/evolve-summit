{
  "name": "Badge",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico por evento (ex: 1A, 2B)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da badge"
    },
    "icone_emoji": {
      "type": "string",
      "description": "Emoji representando o \u00edcone da badge"
    },
    "icone_cor": {
      "type": "string",
      "description": "Cor hex do \u00edcone/badge"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "engajamento",
        "conteudo",
        "networking"
      ],
      "description": "Categoria/linha da matriz"
    },
    "coluna_progresso": {
      "type": "string",
      "enum": [
        "partindo",
        "aquecendo",
        "acelerando",
        "voando"
      ],
      "description": "Coluna de progresso da matriz"
    },
    "criterio_tipo": {
      "type": "string",
      "enum": [
        "first",
        "count",
        "percent",
        "points_total"
      ],
      "description": "Tipo de crit\u00e9rio de desbloqueio"
    },
    "acao_referencia": {
      "type": "string",
      "enum": [
        "presenca_sessao",
        "avaliacao_sessao",
        "pergunta_valida",
        "completude_perfil",
        "conexao_aceita",
        "visita_estande",
        "resgate_realizado"
      ],
      "description": "A\u00e7\u00e3o de refer\u00eancia \u2014 enum \u00fanico acao_evento (nullable)"
    },
    "valor_meta": {
      "type": "number",
      "description": "Valor meta para desbloqueio"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "codigo",
    "titulo",
    "categoria",
    "coluna_progresso",
    "criterio_tipo",
    "valor_meta"
  ]
}