{
  "name": "Checkin",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_in_by": {
      "type": "string",
      "description": "ID do operador"
    },
    "is_reverted": {
      "type": "boolean",
      "default": false
    },
    "reverted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reverted_by": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "participant_id"
  ]
}