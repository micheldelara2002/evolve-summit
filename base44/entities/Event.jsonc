{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de t\u00e9rmino"
    },
    "location": {
      "type": "string",
      "description": "Local do evento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "finished",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status do evento"
    },
    "manager_id": {
      "type": "string",
      "description": "ID do gerente respons\u00e1vel"
    },
    "manager_name": {
      "type": "string",
      "description": "Nome do gerente"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo do evento"
    },
    "color_primary": {
      "type": "string",
      "default": "#4F46E5",
      "description": "Cor prim\u00e1ria do evento"
    },
    "color_secondary": {
      "type": "string",
      "default": "#0D9488",
      "description": "Cor secund\u00e1ria do evento"
    },
    "color_accent": {
      "type": "string",
      "default": "#F59E0B",
      "description": "Cor de destaque do evento"
    },
    "max_participants": {
      "type": "number",
      "description": "M\u00e1ximo de participantes"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    }
  },
  "required": [
    "name",
    "start_date",
    "status"
  ]
}