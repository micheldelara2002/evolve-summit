{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do evento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do evento"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de t\u00e9rmino"
    },
    "location": {
      "type": "string",
      "description": "Local do evento"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "finished",
        "cancelled"
      ],
      "default": "draft",
      "description": "Status do evento"
    },
    "manager_id": {
      "type": "string",
      "description": "ID do gerente respons\u00e1vel"
    },
    "manager_name": {
      "type": "string",
      "description": "Nome do gerente"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo do evento"
    },
    "color_primary": {
      "type": "string",
      "default": "#4F46E5",
      "description": "Cor prim\u00e1ria do evento"
    },
    "color_secondary": {
      "type": "string",
      "default": "#0D9488",
      "description": "Cor secund\u00e1ria do evento"
    },
    "color_accent": {
      "type": "string",
      "default": "#F59E0B",
      "description": "Cor de destaque do evento"
    },
    "max_participants": {
      "type": "number",
      "description": "M\u00e1ximo de participantes"
    },
    "requires_payment": {
      "type": "boolean",
      "default": false,
      "description": "Se o evento exige pagamento para inscri\u00e7\u00e3o"
    },
    "refund_policy": {
      "type": "string",
      "description": "Pol\u00edtica de estorno do evento (JSON: {full_refund_until_days, partial_refund_percent, no_refund_within_days, allow_manual_override})"
    },
    "commission_percent": {
      "type": "number",
      "description": "P0.4 \u2014 Override da comiss\u00e3o da plataforma para este evento (0\u2013100, sobre o valor bruto do ingresso). null/vazio = herda o padr\u00e3o da plataforma (PlatformSetting 'commission')."
    },
    "payout_account_id": {
      "type": "string",
      "description": "P0.4 \u2014 ID da PayoutAccount (conta Stripe Connect do organizador) que recebe as vendas deste evento. Vazio = vendas caem na conta da plataforma (admin)."
    },
    "coupon_codes_registry": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DAT-001 \u2014 Registro de c\u00f3digos de cupom normalizados do evento: constraint l\u00f3gica de unicidade CONCORRENTE por evento (claim at\u00f4mico $ne+$push no manageCommerce \u2014 exatamente um vencedor em corrida; primitivo validado em produ\u00e7\u00e3o 2026-09-28). N\u00c3O \u00e9 fonte de exibi\u00e7\u00e3o (os cupons reais s\u00e3o a entidade Coupon); duplicatas legadas s\u00f3 s\u00e3o diagnosticadas (list), nunca apagadas automaticamente; c\u00f3digo \u00e9 devolvido ao registro no delete apenas se nenhum outro cupom ativo o usa."
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag"
    }
  },
  "required": [
    "name",
    "start_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": {
            "$in": [
              "active",
              "finished"
            ]
          }
        },
        {
          "data.manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}