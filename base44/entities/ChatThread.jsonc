{
  "name": "ChatThread",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "person_a_id": {
      "type": "string",
      "description": "Menor person_id (ordena\u00e7\u00e3o para unicidade do par)"
    },
    "person_b_id": {
      "type": "string",
      "description": "Maior person_id"
    },
    "person_a_name": {
      "type": "string",
      "description": "Nome da pessoa A (snapshot)"
    },
    "person_b_name": {
      "type": "string",
      "description": "Nome da pessoa B (snapshot)"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima mensagem"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Preview da \u00faltima mensagem"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "person_a_id",
    "person_b_id"
  ]
}