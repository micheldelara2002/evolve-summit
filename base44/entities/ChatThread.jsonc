{
  "name": "ChatThread",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "person_a_id": {
      "type": "string",
      "description": "Menor person_id (ordena\u00e7\u00e3o para unicidade do par)"
    },
    "person_b_id": {
      "type": "string",
      "description": "Maior person_id"
    },
    "person_a_name": {
      "type": "string",
      "description": "Nome da pessoa A (snapshot)"
    },
    "person_b_name": {
      "type": "string",
      "description": "Nome da pessoa B (snapshot)"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima mensagem"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Preview da \u00faltima mensagem"
    },
    "last_read_at_a": {
      "type": "string",
      "format": "date-time",
      "description": "P1 \u2014 Quando a pessoa A (person_a_id) leu a conversa pela \u00faltima vez. Base do badge de n\u00e3o-lidas: thread n\u00e3o-lida para A quando last_message_at > last_read_at_a. Atualizado por getChatMessages (leitor) e sendChatMessage (remetente)."
    },
    "last_read_at_b": {
      "type": "string",
      "format": "date-time",
      "description": "P1 \u2014 Quando a pessoa B (person_b_id) leu a conversa pela \u00faltima vez. Base do badge de n\u00e3o-lidas: thread n\u00e3o-lida para B quando last_message_at > last_read_at_b."
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "person_a_id",
    "person_b_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.person_a_id": "{{user.data.person_id}}"
        },
        {
          "data.person_b_id": "{{user.data.person_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}