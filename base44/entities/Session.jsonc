{
  "name": "Session",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "track_id": {
      "type": "string",
      "description": "ID da trilha"
    },
    "room_id": {
      "type": "string",
      "description": "ID da sala"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da sess\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "speaker_id": {
      "type": "string",
      "description": "ID do palestrante (Participant)"
    },
    "speaker_name": {
      "type": "string",
      "description": "Nome do palestrante"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "capacity": {
      "type": "number"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "aula",
        "debate",
        "demonstracao",
        "keynote",
        "mesa_redonda",
        "palestra",
        "painel",
        "simulacao",
        "workshop"
      ],
      "default": "palestra"
    },
    "material_url": {
      "type": "string",
      "description": "URL do material da sess\u00e3o (arquivo/link)"
    },
    "submission_id": {
      "type": "string",
      "description": "ID da Submission que originou esta sess\u00e3o (v\u00ednculo bilateral CFP)"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "title"
  ]
}