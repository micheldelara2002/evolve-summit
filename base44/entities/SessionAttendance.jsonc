{
  "name": "SessionAttendance",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "is_present": {
      "type": "boolean",
      "default": true
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "participant_id"
  ]
}