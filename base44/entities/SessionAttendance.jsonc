{
  "name": "SessionAttendance",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "is_present": {
      "type": "boolean",
      "default": true
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "participant_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.person_id": "{{user.data.person_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.person_id": "{{user.data.person_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.person_id": "{{user.data.person_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}