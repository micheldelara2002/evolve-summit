{
  "name": "SessionAttendance",
  "type": "object",
  "description": "Presen\u00e7a de um participante em uma sess\u00e3o. Lote 4 RLS: travado para admin (SDK direto s\u00f3 pelo admin \u00fanico). Participantes registram/consultam a pr\u00f3pria presen\u00e7a via manageSessionAttendance; palestrantes leem as presen\u00e7as das pr\u00f3prias sess\u00f5es via getSpeakerSessionFeedback.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "is_present": {
      "type": "boolean",
      "default": true
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "participant_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}