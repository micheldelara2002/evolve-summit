{
  "name": "Submission",
  "type": "object",
  "properties": {
    "call_for_papers_id": {
      "type": "string",
      "description": "ID da CallForPapers"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento (denormalizado para isolamento e consulta)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person que submeteu (palestrante)"
    },
    "submitter_name": {
      "type": "string",
      "description": "Nome do palestrante (snapshot)"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email do palestrante (snapshot)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "waitlist",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da submiss\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo proposto para a palestra"
    },
    "summary": {
      "type": "string",
      "description": "Resumo da palestra"
    },
    "proposed_type": {
      "type": "string",
      "enum": [
        "aula",
        "debate",
        "demonstracao",
        "keynote",
        "mesa_redonda",
        "palestra",
        "painel",
        "simulacao",
        "workshop"
      ],
      "default": "palestra",
      "description": "Tipo de sess\u00e3o proposto"
    },
    "custom_answers": {
      "type": "string",
      "description": "JSON com respostas dos campos customizados do form_config"
    },
    "original_submission_id": {
      "type": "string",
      "description": "Se for reuso, ID da submission original clonada"
    },
    "reviewer_id": {
      "type": "string",
      "description": "ID do User que avaliou"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome do avaliador (snapshot)"
    },
    "review_notes": {
      "type": "string",
      "description": "Notas do curador/avaliador"
    },
    "session_id": {
      "type": "string",
      "description": "ID da Session criada quando aprovada (v\u00ednculo bilateral)"
    },
    "participant_id": {
      "type": "string",
      "description": "ID do Participant criado no evento ao aprovar"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "call_for_papers_id",
    "event_id",
    "person_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}