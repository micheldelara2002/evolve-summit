{
  "name": "Submission",
  "type": "object",
  "description": "Proposta submetida a uma CallForPapers. ESCRITA (2026-11-06): SDK direto travado para admin \u2014 o autor cria, edita, exclui e reutiliza a pr\u00f3pria proposta exclusivamente por manageSubmission, que deriva a identidade do usu\u00e1rio autenticado e grava apenas CONTE\u00daDO (t\u00edtulo, resumo, tipo, respostas). Status, autoria, avaliador, sess\u00e3o e participante s\u00e3o decididos no servidor (curadoria) e nunca aceitos do cliente. LEITURA: pr\u00f3prio autor (por e-mail do snapshot ou created_by) e admin; curadoria l\u00ea pela fun\u00e7\u00e3o manageSubmission.",
  "properties": {
    "call_for_papers_id": {
      "type": "string",
      "description": "ID da CallForPapers"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento (denormalizado para isolamento e consulta)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person que submeteu (palestrante)"
    },
    "submitter_name": {
      "type": "string",
      "description": "Nome do palestrante (snapshot)"
    },
    "submitter_email": {
      "type": "string",
      "description": "Email do palestrante (snapshot, normalizado)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "waitlist",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da submiss\u00e3o \u2014 alterado apenas por curadoria/gest\u00e3o do evento (manageSubmission)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo proposto para a palestra"
    },
    "summary": {
      "type": "string",
      "description": "Resumo da palestra"
    },
    "proposed_type": {
      "type": "string",
      "enum": [
        "aula",
        "debate",
        "demonstracao",
        "keynote",
        "mesa_redonda",
        "palestra",
        "painel",
        "simulacao",
        "workshop"
      ],
      "default": "palestra",
      "description": "Tipo de sess\u00e3o proposto"
    },
    "custom_answers": {
      "type": "string",
      "description": "JSON com respostas dos campos customizados do form_config"
    },
    "original_submission_id": {
      "type": "string",
      "description": "Se for reuso, ID da submission original clonada"
    },
    "reviewer_id": {
      "type": "string",
      "description": "ID do User que decidiu (curador/gestor) \u2014 gravado pelo servidor"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome de quem decidiu (snapshot) \u2014 gravado pelo servidor"
    },
    "review_notes": {
      "type": "string",
      "description": "Notas da curadoria"
    },
    "session_id": {
      "type": "string",
      "description": "ID da Session criada quando aprovada (v\u00ednculo bilateral)"
    },
    "participant_id": {
      "type": "string",
      "description": "ID do Participant criado no evento ao aprovar"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "call_for_papers_id",
    "event_id",
    "person_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.submitter_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}