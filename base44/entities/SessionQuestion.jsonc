{
  "name": "SessionQuestion",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "publica",
        "particular"
      ],
      "default": "publica",
      "description": "publica = vis\u00edvel para presentes; particular = s\u00f3 palestrante"
    },
    "is_answered": {
      "type": "boolean",
      "default": false
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "session_id",
    "question"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}