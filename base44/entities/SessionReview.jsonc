{
  "name": "SessionReview",
  "type": "object",
  "description": "Avalia\u00e7\u00e3o de um participante para uma sess\u00e3o (nota + coment\u00e1rio). Lote 4 RLS: travado para admin (SDK direto s\u00f3 pelo admin \u00fanico). Participantes enviam/consultam a pr\u00f3pria avalia\u00e7\u00e3o via saveSessionReview; palestrantes leem as avalia\u00e7\u00f5es das pr\u00f3prias sess\u00f5es via getSpeakerSessionFeedback.",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Nota de 1 a 5"
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "session_id",
    "rating"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}