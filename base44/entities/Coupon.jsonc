{
  "name": "Coupon",
  "type": "object",
  "description": "Cupom de desconto por evento. discount_type 'percent' ou 'fixed'. scope 'per_ticket' ou 'per_cart'. uses_count nunca excede max_uses (guarda at\u00f4mica).",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do cupom (mai\u00fasculas, sem espa\u00e7os)"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed"
      ],
      "default": "percent"
    },
    "value": {
      "type": "number",
      "description": "Percentual (0-100) ou valor fixo em BRL"
    },
    "scope": {
      "type": "string",
      "enum": [
        "per_ticket",
        "per_cart"
      ],
      "default": "per_ticket"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "max_uses": {
      "type": "number",
      "default": 0,
      "description": "0 = ilimitado"
    },
    "uses_count": {
      "type": "number",
      "default": 0,
      "description": "Quantas vezes j\u00e1 foi usado (at\u00f4mico)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "code",
    "discount_type",
    "value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}