{
  "name": "EventInvite",
  "type": "object",
  "description": "Convite de acesso a um evento, criado pelo admin ao informar o e-mail de quem vai gerir o evento. Se a pessoa ainda n\u00e3o tem conta, o convite fica 'pending' e \u00e9 convertido em EventMembership automaticamente no primeiro acesso (shared/eventInvites.linkPendingInvites, chamado pelo getOrCreatePerson). Se j\u00e1 tem conta, o v\u00ednculo \u00e9 criado na hora e o convite nasce 'accepted'. Escritas somente por backend (service role).",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento ao qual o convite d\u00e1 acesso"
    },
    "email": {
      "type": "string",
      "description": "E-mail do convidado, normalizado (min\u00fasculas, sem espa\u00e7os)"
    },
    "invited_name": {
      "type": "string",
      "description": "Nome informado pelo admin no convite"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "manager",
        "team",
        "partner_rep",
        "attendee"
      ],
      "default": "manager",
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "gray"
      ],
      "description": "Papel concedido no evento quando o convite for aceito"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "description": "pending = aguardando a pessoa concluir o cadastro; accepted = v\u00ednculo criado; revoked = cancelado pelo admin"
    },
    "invite_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o e-mail de convite foi disparado"
    },
    "invite_error": {
      "type": "string",
      "description": "Motivo da falha no envio do convite (quando houver)"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o convite virou v\u00ednculo no evento"
    },
    "accepted_user_id": {
      "type": "string",
      "description": "ID do User que aceitou"
    },
    "invited_by_user_id": {
      "type": "string",
      "description": "ID do admin que criou o convite"
    },
    "invited_by_name": {
      "type": "string",
      "description": "Nome do admin que criou o convite"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "email",
    "target_role",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}