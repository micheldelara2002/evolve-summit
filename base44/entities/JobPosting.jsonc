{
  "name": "JobPosting",
  "type": "object",
  "description": "Mural de Vagas \u2014 oportunidades de emprego postadas por participantes dentro do contexto de um evento.",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "participant_id": {
      "type": "string",
      "description": "ID do Participant que postou"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person que postou"
    },
    "poster_name": {
      "type": "string",
      "description": "Nome de quem postou (snapshot)"
    },
    "poster_photo_url": {
      "type": "string",
      "description": "Foto de quem postou (snapshot)"
    },
    "job_title": {
      "type": "string",
      "description": "T\u00edtulo da vaga"
    },
    "contact_email": {
      "type": "string",
      "description": "E-mail para contato"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o breve (at\u00e9 250 caracteres)"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "participant_id",
    "job_title",
    "contact_email"
  ]
}