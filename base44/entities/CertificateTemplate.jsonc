{
  "name": "CertificateTemplate",
  "type": "object",
  "description": "Templates personalizados de certificado enviados pelo gerente do evento. Isolado por evento \u2014 um evento n\u00e3o enxerga templates de outro.",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento (chave de isolamento)"
    },
    "name": {
      "type": "string",
      "description": "Nome identificador do template"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "participacao",
        "palestra"
      ],
      "description": "Tipo de certificado: participacao ou palestra"
    },
    "background_url": {
      "type": "string",
      "description": "URL da imagem de fundo do certificado (PNG, JPG, etc.)"
    },
    "field_configs": {
      "type": "string",
      "description": "JSON com configura\u00e7\u00f5es de posicionamento dos campos din\u00e2micos"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o template est\u00e1 ativo para uso"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "name",
    "tipo",
    "background_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}