{
  "name": "Person",
  "type": "object",
  "description": "Cadastro global de pessoa. Lote 4 RLS: travado para admin (SDK direto s\u00f3 pelo admin \u00fanico). Usu\u00e1rios leem/escrevem a pr\u00f3pria Person via getMyPerson/saveMyPerson; gestores leem/gerenciam via managePerson; resolu\u00e7\u00f5es por ID via getPersonsByIds (backend functions que validam posse/evento).",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo da pessoa"
    },
    "contact_email": {
      "type": "string",
      "description": "Email de contato/perfil (diferente do email de autentica\u00e7\u00e3o)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "company": {
      "type": "string",
      "description": "Empresa"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo"
    },
    "photo_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "bio": {
      "type": "string",
      "description": "Sobre mim"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram"
    },
    "youtube": {
      "type": "string",
      "description": "YouTube"
    },
    "website": {
      "type": "string",
      "description": "Site pessoal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a pessoa est\u00e1 ativa no sistema"
    },
    "created_day": {
      "type": "string",
      "description": "P0.3 \u2014 Chave do dia (YYYY-MM-DD) derivada do created_date. Usada para corre\u00e7\u00e3o de borda no Business Dashboard (equality query). Populado no create; backfill via reconcileGlobalMetrics."
    },
    "metrics_inc": {
      "type": "boolean",
      "default": false,
      "description": "P1 \u2014 Marker de idempot\u00eancia do counter global de persons. true = o bucket global di\u00e1rio de persons j\u00e1 foi incrementado para esta Person (via getOrCreatePerson ou maintainBusinessCounter incPersons). Replays subsequentes s\u00e3o no-op, prevenindo infla\u00e7\u00e3o ilimitada do counter por chamadas repetidas do mesmo usu\u00e1rio."
    },
    "checkout_lock_event_id": {
      "type": "string",
      "description": "FIN-001 \u2014 Evento do checkout atual do comprador. Lock at\u00f4mico de exclusividade (comprador + evento) via Person.updateMany condicional: em corrida h\u00e1 EXATAMENTE um vencedor (primitivo validado 2026-09-28). Vazio = sem lock. Ancorado na Person porque a plataforma bloqueia updateMany bulk na entidade User."
    },
    "checkout_lock_order_id": {
      "type": "string",
      "description": "FIN-001 \u2014 Pedido pendente ao qual o lock vivo pertence. O recheckout (mesma conta, checkout anterior pendente) segue pelo reuso at\u00f4mico deste pedido em vez de ser recusado."
    },
    "checkout_lock_expires_at": {
      "type": "string",
      "description": "FIN-001 \u2014 Validade do lock (ISO-8601). TTL de 15 min = janela de reserva do checkout; expira\u00e7\u00e3o por tempo impede locks \u00f3rf\u00e3os. Libera\u00e7\u00e3o expl\u00edcita e idempotente em falha, cancelamento (expirador) e pagamento confirmado (fulfillment)."
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}