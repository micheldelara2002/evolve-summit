{
  "name": "PayoutAccount",
  "type": "object",
  "description": "Conta Stripe Connect do organizador (destination charges). O dinheiro das vendas cai direto no saldo Stripe do organizador; a plataforma ret\u00e9m apenas a comiss\u00e3o (application fee). Escrita apenas via managePayouts (backend function); organizador l\u00ea a pr\u00f3pria conta, admin l\u00ea todas.",
  "properties": {
    "manager_user_id": {
      "type": "string",
      "description": "ID do User organizador (dono da conta)"
    },
    "manager_name": {
      "type": "string",
      "description": "Nome do organizador (snapshot)"
    },
    "legal_name": {
      "type": "string",
      "description": "Raz\u00e3o social da empresa organizadora"
    },
    "legal_document_number": {
      "type": "string",
      "description": "CNPJ da empresa organizadora (apenas d\u00edgitos)"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "ID da conta conectada no Stripe (acct_...)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "restricted",
        "rejected"
      ],
      "default": "pending",
      "description": "Status do onboarding/verifica\u00e7\u00e3o da conta no Stripe"
    },
    "charges_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta pode receber cobran\u00e7as (verifica\u00e7\u00e3o conclu\u00edda)"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta pode sacar para o banco do organizador"
    },
    "reserve_amount": {
      "type": "number",
      "default": 0,
      "description": "Reserva de saldo m\u00ednimo (BRL) retida pelo Stripe na conta do organizador para amortecer estornos p\u00f3s-saque"
    },
    "requirements_json": {
      "type": "string",
      "description": "JSON snapshot dos requisitos pendentes do Stripe (currently_due, past_due, disabled_reason)"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "manager_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.manager_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}