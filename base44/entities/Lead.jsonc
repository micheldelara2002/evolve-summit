{
  "name": "Lead",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do parceiro"
    },
    "participant_id": {
      "type": "string",
      "description": "ID do Participant que gerou o lead"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person vinculada (chave de unicidade com event_id + partner_id)"
    },
    "participant_name": {
      "type": "string",
      "description": "Nome do participante (snapshot)"
    },
    "participant_email": {
      "type": "string",
      "description": "E-mail do participante (snapshot)"
    },
    "source": {
      "type": "string",
      "enum": [
        "booth_scan",
        "session",
        "networking",
        "manual"
      ],
      "default": "manual",
      "description": "Origem do lead"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "quality": {
      "type": "string",
      "enum": [
        "hot",
        "warm",
        "cold"
      ],
      "default": "warm",
      "description": "Qualifica\u00e7\u00e3o do lead"
    },
    "visited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da visita ao estande"
    },
    "person_phone": {
      "type": "string",
      "description": "Telefone (snapshot da Person)"
    },
    "person_linkedin": {
      "type": "string",
      "description": "LinkedIn (snapshot da Person)"
    },
    "person_company": {
      "type": "string",
      "description": "Empresa (snapshot da Person)"
    },
    "person_job_title": {
      "type": "string",
      "description": "Cargo (snapshot da Person)"
    },
    "created_day": {
      "type": "string",
      "description": "P0.3 \u2014 Chave do dia (YYYY-MM-DD) derivada do created_date. Usada para corre\u00e7\u00e3o de borda no Business Dashboard (equality query). Populado no create; backfill via reconcileBusinessMetrics."
    }
  },
  "required": [
    "event_id",
    "participant_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}