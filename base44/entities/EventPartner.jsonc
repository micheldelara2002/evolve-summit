{
  "name": "EventPartner",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do partner global"
    },
    "sponsorship_plan": {
      "type": "string",
      "enum": [
        "diamante",
        "ouro",
        "prata",
        "bronze",
        "apoiador"
      ],
      "description": "Plano de patroc\u00ednio no contexto do evento"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "partner_id",
    "sponsorship_plan"
  ]
}