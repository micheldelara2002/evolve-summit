{
  "name": "EventPartner",
  "type": "object",
  "description": "V\u00ednculo de um Partner a um Evento com plano de patroc\u00ednio. Lote 1 RLS: travado para admin (SDK direto s\u00f3 pelo admin \u00fanico). Participantes/parceiros leem via getEventPartners (backend function que valida membership).",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "partner_id": {
      "type": "string",
      "description": "ID do partner global"
    },
    "sponsorship_plan": {
      "type": "string",
      "enum": [
        "diamante",
        "ouro",
        "prata",
        "bronze",
        "apoiador"
      ],
      "description": "Plano de patroc\u00ednio no contexto do evento"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descri\u00e7\u00e3o livre (opcional, m\u00e1x 1000 caracteres)"
    }
  },
  "required": [
    "event_id",
    "partner_id",
    "sponsorship_plan"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}