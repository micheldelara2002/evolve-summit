{
  "name": "Participant",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (normalizado, sem pontos/tra\u00e7os) \u2014 opcional"
    },
    "phone": {
      "type": "string",
      "description": "Telefone \u2014 opcional"
    },
    "company": {
      "type": "string",
      "description": "Empresa"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram"
    },
    "youtube": {
      "type": "string",
      "description": "Youtube"
    },
    "website": {
      "type": "string",
      "description": "Site"
    },
    "bio": {
      "type": "string",
      "description": "Sobre mim"
    },
    "role_in_event": {
      "type": "string",
      "enum": [
        "attendee",
        "speaker",
        "team",
        "manager",
        "partner_rep"
      ],
      "default": "attendee"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "registered",
        "confirmed",
        "cancelled"
      ],
      "default": "registered"
    },
    "import_id": {
      "type": "string",
      "description": "ID da importa\u00e7\u00e3o (se veio via CSV)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person vinculada (se existir)"
    },
    "points_total": {
      "type": "number",
      "default": 0,
      "description": "Pontos totais acumulados no evento (n\u00e3o reduz com resgate)"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Campo legado \u2014 mantido em sincronia com points_total"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "full_name",
    "email"
  ]
}