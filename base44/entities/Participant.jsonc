{
  "name": "Participant",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID do evento"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo"
    },
    "email": {
      "type": "string",
      "description": "E-mail"
    },
    "cpf": {
      "type": "string",
      "description": "CPF (normalizado, sem pontos/tra\u00e7os) \u2014 opcional"
    },
    "phone": {
      "type": "string",
      "description": "Telefone \u2014 opcional"
    },
    "company": {
      "type": "string",
      "description": "Empresa"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram"
    },
    "youtube": {
      "type": "string",
      "description": "Youtube"
    },
    "website": {
      "type": "string",
      "description": "Site"
    },
    "bio": {
      "type": "string",
      "description": "Sobre mim"
    },
    "role_in_event": {
      "type": "string",
      "enum": [
        "attendee",
        "speaker",
        "team",
        "manager",
        "partner_rep"
      ],
      "default": "attendee"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "registered",
        "confirmed",
        "cancelled"
      ],
      "default": "registered"
    },
    "import_id": {
      "type": "string",
      "description": "ID da importa\u00e7\u00e3o (se veio via CSV)"
    },
    "person_id": {
      "type": "string",
      "description": "ID da Person vinculada (se existir)"
    },
    "points_total": {
      "type": "number",
      "default": 0,
      "description": "Pontos totais acumulados no evento (n\u00e3o reduz com resgate)"
    },
    "redeemed_total": {
      "type": "number",
      "default": 0,
      "description": "P0.2 \u2014 Total de pontos debitados via resgates n\u00e3o-cancelados (counter at\u00f4mico, mantido por redeemStoreItem)"
    },
    "checkin_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed"
      ],
      "default": "pending",
      "description": "Status do check-in geral do evento (credenciamento)"
    },
    "checkin_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o check-in foi confirmado"
    },
    "checked_in_by_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (staff/gerente) que confirmou o check-in"
    },
    "created_day": {
      "type": "string",
      "description": "P0.3 \u2014 Chave do dia (YYYY-MM-DD) derivada do created_date. Usada para corre\u00e7\u00e3o de borda no Business Dashboard (equality query), j\u00e1 que range queries no created_date (built-in) n\u00e3o funcionam. Populado em todos os create paths; backfill via reconcileBusinessMetrics."
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "full_name",
    "email"
  ]
}