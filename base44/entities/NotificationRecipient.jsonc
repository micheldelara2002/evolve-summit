{
  "name": "NotificationRecipient",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "ID da campanha"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "P0 \u2014 ID do USER (conta do app) destinat\u00e1rio. SEMPRE um User ID real: a RLS de leitura e o NotificationInbox casam com {{user.id}}. Audi\u00eancias de evento resolvem Participant \u2192 e-mail \u2192 User, e segmentos de papel resolvem via EventMembership (user_id ancorado). Participante SEM conta de app N\u00c3O gera registro (regra de neg\u00f3cio)."
    },
    "recipient_name": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio (snapshot)"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email do destinat\u00e1rio (snapshot, lowercase)"
    },
    "recipient_role": {
      "type": "string",
      "description": "Role do destinat\u00e1rio no evento (snapshot)"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Status de entrega"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de entrega (nullable)"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de leitura (nullable)"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de clique no CTA (nullable)"
    },
    "error_reason": {
      "type": "string",
      "description": "Motivo do erro se falhou (nullable)"
    }
  },
  "required": [
    "campaign_id",
    "recipient_user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}