{
  "name": "PersonDocument",
  "type": "object",
  "description": "Documento de identifica\u00e7\u00e3o de uma Person. SEC-001 \u2014 escritas diretas via SDK restritas ao admin: o dono N\u00c3O pode alterar person_id por update direto (a condi\u00e7\u00e3o de RLS antiga validava o registro EXISTENTE, n\u00e3o o novo valor, permitindo transferir a posse do documento). Usu\u00e1rio comum cria/edita/exclui exclusivamente via managePersonDocument, que deriva o person_id do usu\u00e1rio autenticado no servidor e nunca aceita troca de titular em update.",
  "properties": {
    "person_id": {
      "type": "string",
      "description": "ID da pessoa"
    },
    "country_code": {
      "type": "string",
      "default": "BR",
      "description": "C\u00f3digo do pa\u00eds (ISO 3166-1 alpha-2)"
    },
    "document_type": {
      "type": "string",
      "default": "CPF",
      "description": "Tipo de documento (CPF, RG, PASSAPORTE, etc.)"
    },
    "document_number": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 o documento principal da pessoa"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Status do documento"
    }
  },
  "required": [
    "person_id",
    "country_code",
    "document_type",
    "document_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.person_id": "{{user.data.person_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}