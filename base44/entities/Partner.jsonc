{
  "name": "Partner",
  "type": "object",
  "properties": {
    "legal_name": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "trade_name": {
      "type": "string",
      "description": "Nome comercial/fantasia (exibido como nome principal)"
    },
    "legal_country_code": {
      "type": "string",
      "default": "BR",
      "description": "Pa\u00eds do documento legal"
    },
    "legal_document_type": {
      "type": "string",
      "default": "CNPJ",
      "description": "Tipo do documento legal (CNPJ, EIN, VAT, TAX_ID, OTHER)"
    },
    "legal_document_number": {
      "type": "string",
      "description": "N\u00famero do documento legal"
    },
    "contact_email": {
      "type": "string",
      "description": "E-mail de contato"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "website": {
      "type": "string",
      "description": "Site"
    },
    "about": {
      "type": "string",
      "description": "Sobre a empresa (substitui description)"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo (legado / upload)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a empresa est\u00e1 ativa"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "event_id": {
      "type": "string",
      "description": "DEPRECATED: legado. N\u00e3o usar no fluxo novo."
    },
    "name": {
      "type": "string",
      "description": "DEPRECATED: legado. Usar trade_name."
    },
    "plan": {
      "type": "string",
      "description": "DEPRECATED: legado."
    }
  },
  "required": [
    "legal_name",
    "trade_name",
    "legal_country_code",
    "legal_document_type",
    "legal_document_number"
  ]
}