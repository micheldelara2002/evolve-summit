{
  "name": "Partner",
  "type": "object",
  "description": "Empresa parceira (cat\u00e1logo global de patrocinadores). Lote 2 RLS: travado para admin (SDK direto s\u00f3 pelo admin). Gestores (partner_manager) leem a pr\u00f3pria empresa via getPartnerProfile e gerenciam via savePartner; exibi\u00e7\u00f5es p\u00fablicas (patrocinadores, ficha de estande) usam getPublicPartners/getSpeakerPartner (campos p\u00fablicos sem PII).",
  "properties": {
    "legal_name": {
      "type": "string",
      "description": "Raz\u00e3o social"
    },
    "trade_name": {
      "type": "string",
      "description": "Nome comercial/fantasia (exibido como nome principal)"
    },
    "legal_country_code": {
      "type": "string",
      "default": "BR",
      "description": "Pa\u00eds do documento legal"
    },
    "legal_document_type": {
      "type": "string",
      "default": "CNPJ",
      "description": "Tipo do documento legal (CNPJ, EIN, VAT, TAX_ID, OTHER)"
    },
    "legal_document_number": {
      "type": "string",
      "description": "N\u00famero do documento legal"
    },
    "contact_email": {
      "type": "string",
      "description": "E-mail de contato"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "website": {
      "type": "string",
      "description": "Site"
    },
    "about": {
      "type": "string",
      "description": "Sobre a empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a empresa est\u00e1 ativa"
    },
    "created_day": {
      "type": "string",
      "description": "P0.3 \u2014 Chave do dia (YYYY-MM-DD) derivada do created_date. Usada para corre\u00e7\u00e3o de borda no Business Dashboard (equality query). Populado no create; backfill via reconcileGlobalMetrics."
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "legal_name",
    "trade_name",
    "legal_country_code",
    "legal_document_type",
    "legal_document_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}