{
  "name": "Expirar Reservas Abandonadas",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expire_stale_reservations",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expirar_reservas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireStaleReservations"
          },
          "then": "end",
          "x-base44": {
            "title": "Manuten\u00e7\u00e3o financeira autom\u00e1tica",
            "description": "Expira reservas, recupera emiss\u00f5es, reconcilia estornos"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Manuten\u00e7\u00e3o financeira autom\u00e1tica (a cada 5 min): expira reservas abandonadas (reconfirmando o estado no Stripe antes de cancelar), recupera emiss\u00f5es incompletas de pedidos recentes e reconcilia estornos pendentes. P0 (2026-09-29) \u2014 endpoint p\u00fablico seguro-por-constru\u00e7\u00e3o (mesmo modelo do stripeWebhook): opera\u00e7\u00f5es idempotentes/convergentes, resposta sem PII, limites por execu\u00e7\u00e3o e limitador de frequ\u00eancia de 4 min via PlatformSetting 'maintenance' (CAS garante uma \u00fanica execu\u00e7\u00e3o real em corridas)."
}